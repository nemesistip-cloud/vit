modules = ["python-3.11", "nodejs-20", "web", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[userenv]

[userenv.shared]
APP_VERSION = "4.6.0"
ENVIRONMENT = "development"
PORT = "5000"
CORS_ALLOWED_ORIGINS = "*"
AUTH_ENABLED = "true"
USE_REAL_ML_MODELS = "true"
ML_MODEL_CACHE_ENABLED = "true"
BLOCKCHAIN_ENABLED = "true "
ADMIN_EMAIL = "admin@vit.network"
ADMIN_USERNAME = "vit_admin"
ENABLE_SCRAPING = "true"
ENABLE_ODDS = "true"
MAX_STAKE = "0.05"
MIN_EDGE_THRESHOLD = "0.02"
USDT_MIN_CONFIRMATIONS = "3"
TELEGRAM_BOT_USERNAME = "vit_alerts_bot"
RATE_LIMIT_ENABLED = "true"
ACCESS_TOKEN_EXPIRE_MINUTES = "60"
REFRESH_TOKEN_EXPIRE_DAYS = "30"
BACKEND_PORT = "8000"
FRONTEND_PORT = "5000"
JWT_SECRET_KEY = "6ababe7804b6a8ef5b9f91236aa56741baec9b7c8c9c647d0480d34f1909ef47c71cc05a71bc3cdc3dd5949b47055ef2259411b759fcbbb43eff3b3f189a8b5a"
SECRET_KEY = "6ababe7804b6a8ef5b9f91236aa56741baec9b7c8c9c647d0480d34f1909ef47c71cc05a71bc3cdc3dd5949b47055ef2259411b759fcbbb43eff3b3f189a8b5a"
API_KEY = "vit-platform-api-2026-6ababe7804b6a8ef"
ADMIN_PASSWORD = "VitAdmin2026!Secure#"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start_fullstack.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 5002
externalPort = 4200

[[ports]]
localPort = 5003
externalPort = 3002

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8001
externalPort = 3000

[nix]
channel = "stable-25_05"
packages = ["cargo", "freetype", "glibcLocales", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "ocl-icd", "opencl-headers", "openjpeg", "openssl", "pkg-config", "postgresql", "rustc", "tcl", "tk", "xcodebuild", "xsimd", "zlib"]

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "scripts/start_production.sh"]
build = ["bash", "scripts/start_production.sh"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
