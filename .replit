modules = ["python-3.11", "nodejs-20"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[userenv]

[userenv.shared]
APP_VERSION = "4.6.0"
ENVIRONMENT = "production"
PORT = "5000"
CORS_ALLOWED_ORIGINS = "true "
VIT_DATABASE_URL = "sqlite+aiosqlite:///./vit.db"
AUTH_ENABLED = "true"
USE_REAL_ML_MODELS = "true"
ML_MODEL_CACHE_ENABLED = "true"
BLOCKCHAIN_ENABLED = "false"
ADMIN_EMAIL = "admin@vit.network"
ADMIN_USERNAME = "vit_admin"
ENABLE_SCRAPING = "true"
ENABLE_ODDS = "true"
MAX_STAKE = "0.05"
MIN_EDGE_THRESHOLD = "0.02"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start_fullstack.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8000
externalPort = 8000

[nix]
channel = "stable-25_05"
packages = ["cargo", "freetype", "glibcLocales", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "ocl-icd", "opencl-headers", "openjpeg", "openssl", "pkg-config", "postgresql", "rustc", "tcl", "tk", "xcodebuild", "xsimd", "zlib"]

[deployment]
deploymentTarget = "cloudrun"
