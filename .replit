modules = ["python-3.11", "nodejs-20", "web", "bash"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["python_openai_ai_integrations:1.0.0", "python_anthropic_ai_integrations:1.0.0", "python_openrouter_ai_integrations:1.0.0"]

[userenv]

[userenv.shared]
APP_VERSION = "5.0.0"
ENVIRONMENT = "development"
PORT = "5000"
CORS_ALLOWED_ORIGINS = "*"
AUTH_ENABLED = "true"
USE_REAL_ML_MODELS = "true"
ML_MODEL_CACHE_ENABLED = "true"
BLOCKCHAIN_ENABLED = "true"
ADMIN_EMAIL = "admin@vit.network"
ADMIN_USERNAME = "vit_admin"
ENABLE_SCRAPING = "true"
ENABLE_ODDS = "true"
MAX_STAKE = "0.05"
MIN_EDGE_THRESHOLD = "0.02"
USDT_MIN_CONFIRMATIONS = "3"
TELEGRAM_BOT_USERNAME = "vit_alerts_bot"
RATE_LIMIT_ENABLED = "true"
ACCESS_TOKEN_EXPIRE_MINUTES = "60"
REFRESH_TOKEN_EXPIRE_DAYS = "30"
BACKEND_PORT = "8000"
FRONTEND_PORT = "5000"
PYTORCH_DEVICE = "cpu"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start_fullstack.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 8000
externalPort = 8000

[nix]
channel = "stable-25_05"
packages = ["cargo", "freetype", "glibcLocales", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "ocl-icd", "opencl-headers", "openjpeg", "openssl", "pkg-config", "postgresql", "rustc", "tcl", "tk", "xcodebuild", "xsimd", "zlib"]

[deployment]
deploymentTarget = "vm"
run = ["bash", "scripts/start_production.sh"]
build = ["bash", "scripts/build.sh"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
