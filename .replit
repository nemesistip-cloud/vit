modules = ["python-3.11", "nodejs-20", "bash", "web"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/start_fullstack.sh"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3001

[[ports]]
localPort = 8001
externalPort = 3000

[[ports]]
localPort = 8002
externalPort = 3003

[nix]
channel = "stable-25_05"
packages = ["cargo", "freetype", "glibcLocales", "lcms2", "libiconv", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssl", "pkg-config", "postgresql", "rustc", "tcl", "tk", "xcodebuild", "xsimd", "zlib"]

[deployment]
deploymentTarget = "vm"
run = ["bash", "scripts/start_production.sh"]
build = ["bash", "-c", "cd frontend && npm install --prefer-offline --silent && npm run build"]

[userenv]

[userenv.shared]
GCP_PROJECT_ID = "vitnetwork-63818"
PORT = "5000"
ENVIRONMENT = "development"
APP_VERSION = "5.5.0"
MAX_PREDICTIONS_PER_DAY = "20"
BOOTSTRAP_MATCH_MONTHS = "12"
THESPORTSDB_API_KEY = "3"
