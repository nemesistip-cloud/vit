# Large caches — not needed in deployment image
.cache/
.local/share/
.npm/

# Frontend node_modules — reinstalled during build via npm install
frontend/node_modules/

# Python bytecode caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd

# Dev tools
.git/
.github/
attached_assets/
screenshots/
*.log

# OS junk
.DS_Store
Thumbs.db
