# Python package cache — reinstalled during build via pip install -r requirements.txt
.pythonlibs/

# pip / npm / misc caches — not needed in deployment image
.cache/
.local/share/
.npm/

# Frontend node_modules — reinstalled during build via npm install
frontend/node_modules/

# Python bytecode caches
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Dev tools
.git/
.github/
attached_assets/
screenshots/
*.log

# Jupyter / ML experiment artefacts
*.ipynb_checkpoints/
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db
