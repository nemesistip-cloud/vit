# VIT Sports Intelligence Network v5 environment template (NATIVE AI MODE)
# Copy to .env for local development. Do not commit real secrets.

# Application
APP_VERSION=5.2.0
ENVIRONMENT=development
PORT=5000

# Security
JWT_SECRET_KEY=
API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./vit.db

# Data providers
FOOTBALL_DATA_API_KEY=
ISPORTS_API_KEY=
ODDS_API_KEY=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Payments and wallet
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Cloud (GCS & Secrets)
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional worker/cache
REDIS_URL=
