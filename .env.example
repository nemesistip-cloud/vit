# VIT Sports Analytics Network v5 environment template (NATIVE AI MODE)
# Copy to .env for local development. Do not commit real secrets.

# Application
APP_VERSION=5.2.0
ENVIRONMENT=development
PORT=5000

# Security
JWT_SECRET_KEY=
API_KEY=

# Database
DATABASE_URL=sqlite+aiosqlite:///./vit.db

# Data providers
FOOTBALL_DATA_API_KEY=
ISPORTS_API_KEY=
ODDS_API_KEY=

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Payments and wallet
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Cloud (Secrets)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Optional worker/cache
REDIS_URL=

# Email
RESEND_API_KEY=              # Required for email — get from resend.com

# TheSportsDB (free key, no registration required)
THESPORTSDB_API_KEY=3

# Prediction limits
MAX_PREDICTIONS_PER_DAY=20

# Bootstrap
BOOTSTRAP_MATCH_MONTHS=12

# Frontend
VITE_API_URL=

# ── Google Cloud Platform ─────────────────────────────────────────────────────
# Production Cloud Run URL
CLOUD_RUN_URL=https://vit-897838355273.europe-west1.run.app

# GCP project (set in Cloud Run environment automatically)
GCP_PROJECT_ID=
GCP_REGION=europe-west1

# GCP Project Config

# Populated automatically from Secret Manager in Cloud Run.
# Set these locally for development only — never commit real values.
# DATABASE_URL=postgresql+asyncpg://vit_app:PASSWORD@/vit_db?host=/cloudsql/PROJECT:europe-west1:vit-postgres
# REDIS_URL=redis://MEMORYSTORE_HOST:6379/0
